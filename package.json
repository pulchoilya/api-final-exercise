{
  "name": "dojo.api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "// 1. app": "----------------------------------------------------------",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",

    "// 2. database": "-----------------------------------------------------",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:clean-test-users": "npx tsx prisma/cleanupTestUsers.ts",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",

    "// 3. playwright: run scenarios": "---------------------------------",
    "test": "npx playwright test",
    "test:ci": "npx playwright test --workers=2",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:report": "npx playwright show-report tests/playwright-report",

    "// 4. playwright: by resource (tag filter)": "----------------------",
    "test:auth": "npx playwright test --grep @auth",
    "test:oauth": "npx playwright test --grep @oauth",
    "test:users": "npx playwright test --grep @users",
    "test:courses": "npx playwright test --grep @courses",
    "test:chapters": "npx playwright test --grep @chapters",
    "test:tags": "npx playwright test --grep @tags",
    "test:posts": "npx playwright test --grep @posts",
    "test:promoCodes": "npx playwright test --grep @promoCodes",
    "test:purchases": "npx playwright test --grep @purchases",
    "test:learningPaths": "npx playwright test --grep @learningPaths"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@scalar/nextjs-api-reference": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "jose": "^6.0.11",
    "mariadb": "^3.5.2",
    "next": "16.2.1",
    "prisma": "^7.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  }
}
